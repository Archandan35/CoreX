# These values are supplied automatically by the deployment platform (e.g.
# Cloudflare Pages environment variables). Do NOT hard-code real credentials in
# this file or in the repository. The VITE_-prefixed vars below are PUBLIC
# (anon) values safe to expose to the browser; the service role key is NOT
# listed here because it must never be bundled into the client.
VITE_AUTH_PROVIDER=supabase
VITE_DATABASE_PROVIDER=supabase
VITE_STORAGE_PROVIDER=supabase

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_SUPABASE_BUCKET=your_bucket_name

# The application URL for the CURRENT environment. Used as the base for auth
# email redirects (email confirmation, password recovery, etc.).
#   - Development: http://localhost:3000
# - Production (this project): https://corex-system.pages.dev
# In a browser, the app additionally guards against a stale localhost value:
# if VITE_APP_URL disagrees with the real origin (or is localhost while the app
# is deployed), the real origin (window.location.origin) is used for redirects —
# so a localhost value here can never leak into production auth emails.
# Also configure matching URLs in the Supabase dashboard:
# Authentication → URL Configuration: Site URL = https://corex-system.pages.dev
# and add https://corex-system.pages.dev/* to Redirect URLs.
VITE_APP_URL=http://localhost:3000

# --- SERVER-ONLY SECRET (DO NOT prefix with VITE_) ---
# The Supabase service role key bypasses Row Level Security and is a full-admin
# credential. It must NEVER be exposed to the browser, so it is intentionally
# NOT a VITE_ variable. Set it on the server / CI environment only:
#   SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
# It is read exclusively via process.env by server-only code (see
# src/config/serverSecrets.js) and is only needed for the local dev server's
# administrative API endpoints. During first-time setup the service role key is
# entered by the operator directly into the Setup Wizard form (never read from
# env there) and is used transiently for schema installation only.
